# BaphOS — тема окон labwc (пиксель-арт, без теней и скруглений: железо слабое)
# Палитра: чёрный фон, алый #ff1a1a, тёмно-красный #6b0000 / #3a0000, текст #d8d8d8

border.width: 2
window.titlebar.padding.width: 2
window.titlebar.padding.height: 2

window.active.border.color: #6b0000
window.inactive.border.color: #3a0000
window.active.indicator.toggled-keybind.color: #ff1a1a

window.active.title.bg.color: #000000
window.inactive.title.bg.color: #0a0a0a
window.active.label.text.color: #ff1a1a
window.inactive.label.text.color: #6b0000
window.label.text.justify: left

window.button.width: 20
window.button.height: 18
window.button.spacing: 2
window.button.hover.bg.color: #00000000
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 0
window.inactive.shadow.size: 0

# меню (правый клик по рабочему столу, меню окна)
menu.border.width: 2
menu.border.color: #6b0000
menu.items.bg.color: #000000
menu.items.text.color: #d8d8d8
menu.items.active.bg.color: #ff1a1a
menu.items.active.text.color: #000000
menu.items.padding.x: 8
menu.items.padding.y: 3
menu.title.bg.color: #3a0000
menu.title.text.color: #ff1a1a
menu.separator.width: 1
menu.separator.padding.width: 4
menu.separator.padding.height: 3
menu.separator.color: #3a0000
menu.overlap.x: 0
menu.overlap.y: 0

# экранные подсказки и Alt+Tab
osd.bg.color: #000000
osd.border.color: #ff1a1a
osd.border.width: 2
osd.label.text.color: #d8d8d8
osd.window-switcher.style-classic.width: 480
osd.window-switcher.style-classic.padding: 4
osd.window-switcher.style-classic.item.padding.x: 8
osd.window-switcher.style-classic.item.padding.y: 3
osd.window-switcher.style-classic.item.active.border.width: 2
osd.window-switcher.style-classic.item.active.border.color: #ff1a1a
osd.window-switcher.style-classic.item.active.bg.color: #3a0000
osd.window-switcher.preview.border.width: 2
osd.window-switcher.preview.border.color: #ff1a1a,#000000,#ff1a1a
osd.workspace-switcher.boxes.width: 24
osd.workspace-switcher.boxes.height: 16
osd.workspace-switcher.boxes.border.width: 2

# прилипание к краям: плоская рамка вместо полупрозрачной заливки
snapping.overlay.region.bg.enabled: no
snapping.overlay.edge.bg.enabled: no
snapping.overlay.region.border.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: #ff1a1a,#000000,#ff1a1a
snapping.overlay.edge.border.color: #ff1a1a,#000000,#ff1a1a
