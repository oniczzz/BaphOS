<?xml version="1.0"?>
<!-- BaphOS: labwc как Windows. Документация: man labwc-config, /usr/share/doc/labwc/rc.xml.all -->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <theme>
    <name>BaphOS</name>
    <!-- значки окон; свои пиксельные — на этапе 3 -->
    <icon>Adwaita</icon>
    <titlebar>
      <!-- как в Windows: значок слева, кнопки справа -->
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>no</dropShadows>
    <font><name>Cozette</name><size>10</size></font>
  </theme>

  <windowSwitcher preview="no" outlines="yes">
    <osd show="yes" style="classic" output="focused" />
    <fields>
      <field content="icon" width="8%" />
      <field content="title" width="92%" />
    </fields>
  </windowSwitcher>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>50</cornerRange>
    <overlay enabled="yes">
      <delay inner="300" outer="300" />
    </overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <desktops number="1" />

  <keyboard>
    <default />
    <layoutScope>global</layoutScope>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="nautilus" /></keybind>
    <keybind key="W-b"><action name="Execute" command="helium-browser" /></keybind>
    <keybind key="W-space"><action name="Execute" command="fuzzel" /></keybind>
    <keybind key="W-p"><action name="Execute" command="wdisplays" /></keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim ~/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim -g &quot;$(slurp)&quot; ~/Pictures/Screenshots/$(date +%Y%m%d-%H%M%S).png'" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <naturalScroll>no</naturalScroll>
    </device>
  </libinput>

</labwc_config>
