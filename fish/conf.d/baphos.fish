# BaphOS: цвета подсветки fish в палитре (чёрный / алый / тёмно-красный / кость).
# Приветствие (fastfetch) остаётся от CachyOS — fastfetch берёт конфиг BaphOS.
set -g fish_color_normal d8d8d8
set -g fish_color_command ff1a1a
set -g fish_color_keyword ff1a1a --bold
set -g fish_color_param d8d8d8
set -g fish_color_option a8a0a0
set -g fish_color_quote b8955a
set -g fish_color_redirection a00000
set -g fish_color_end a00000
set -g fish_color_error ff5040 --underline
set -g fish_color_comment 3a3434
set -g fish_color_operator a00000
set -g fish_color_escape b02a52
set -g fish_color_autosuggestion 3a3434
set -g fish_color_valid_path --underline
set -g fish_color_search_match --background=3a0000
set -g fish_color_selection --background=3a0000
set -g fish_pager_color_prefix ff1a1a --bold
set -g fish_pager_color_completion d8d8d8
set -g fish_pager_color_description 787070
set -g fish_pager_color_progress 000000 --background=ff1a1a
