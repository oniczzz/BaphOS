#!/usr/bin/env python3
"""BaphOS: записать текущие мониторы niri (режим, масштаб, положение) в ~/.config/niri/monitor.kdl."""
import json
import os
import subprocess

d = json.loads(subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True, text=True, check=True).stdout)
out = ["// Мониторы — записано Настройками BaphOS (Экран → Сохранить)"]
for name, o in d.items():
    if o.get("logical") is None:
        out.append(f'output "{name}" {{\n    off\n}}')
        continue
    m = o["modes"][o["current_mode"]] if o.get("current_mode") is not None else None
    lg = o["logical"]
    out.append(f'output "{name}" {{')
    if m:
        out.append(f'    mode "{m["width"]}x{m["height"]}@{m["refresh_rate"] / 1000:.3f}"')
    out.append(f'    scale {lg["scale"]}')
    out.append(f'    position x={lg["x"]} y={lg["y"]}')
    out.append("}")
path = os.path.expanduser("~/.config/niri/monitor.kdl")
open(path, "w").write("\n".join(out) + "\n")
print(path)
