#!/usr/bin/env python3
"""Список окон niri в fuzzel: выбрал — niri переключился на это окно (Mod+Tab)."""
import json
import subprocess
import sys

windows = json.loads(subprocess.run(["niri", "msg", "--json", "windows"],
                                    capture_output=True, text=True, check=True).stdout)
if not windows:
    sys.exit(0)

# сфокусированное окно — в конец списка, остальные по рабочим столам
windows.sort(key=lambda w: (w.get("is_focused", False), w.get("workspace_id") or 0))

lines = []
for w in windows:
    app = w.get("app_id") or "?"
    title = (w.get("title") or "").replace("\n", " ")
    # fuzzel dmenu: текст\0icon\x1fимя-иконки
    lines.append(f"{app} — {title}\0icon\x1f{app}")

res = subprocess.run(["fuzzel", "--dmenu", "--index", "--prompt", "Окно: "],
                     input="\n".join(lines), capture_output=True, text=True)
if res.returncode != 0 or not res.stdout.strip().isdigit():
    sys.exit(0)

chosen = windows[int(res.stdout.strip())]
subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(chosen["id"])])
