// BaphOS: short fastfetch with the sigil (run it with: ff). Colours come from the terminal palette.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 0, "left": 1, "right": 3 }
    },
    "display": {
        "separator": " ❯ ",
        "color": { "keys": "31", "title": "91", "separator": "90" },
        "key": { "width": 10 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "custom", "format": "\u001b[90m† ───────────────── †" },
        { "type": "os", "key": "OS", "format": "{name}" },
        { "type": "kernel", "key": "Kernel", "format": "{release}" },
        { "type": "wm", "key": "WM", "format": "{pretty-name}" },
        { "type": "shell", "key": "Shell", "format": "{pretty-name}" },
        { "type": "cpu", "key": "CPU", "format": "{name}" },
        { "type": "memory", "key": "Memory" },
        { "type": "uptime", "key": "Uptime" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
