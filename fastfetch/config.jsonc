// BaphOS: короткий fastfetch с сигилом. Цвета — из палитры терминала (foot: красный = алый).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": { "top": 0, "left": 1, "right": 3 }
    },
    "display": {
        "separator": " ❯ ",
        "color": { "keys": "31", "title": "91", "separator": "90" },
        "key": { "width": 12 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "custom", "format": "\u001b[90m† ───────────────── †" },
        { "type": "os", "key": "система", "format": "{name}" },
        { "type": "kernel", "key": "ядро", "format": "{release}" },
        { "type": "wm", "key": "окна", "format": "{pretty-name}" },
        { "type": "shell", "key": "оболочка", "format": "{pretty-name}" },
        { "type": "cpu", "key": "ЦП", "format": "{name}" },
        { "type": "memory", "key": "память" },
        { "type": "uptime", "key": "бдение" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
